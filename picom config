backend = "glx";
vsync = true;

# Rounded corners (includes Polybar)
corner-radius = 12;
rounded-corners-exclude = [
  "window_type = 'desktop'"
];

# Frosted glass blur (includes Polybar)
blur: {
  method = "dual_kawase";
  strength = 7;
  background = false;
  background-frame = false;
  background-fixed = false;
}
blur-background-exclude = [
  "window_type = 'desktop'"
];

# Smooth fade animations
fading = true;
fade-in-step = 0.04;
fade-out-step = 0.04;
fade-delta = 5;

# Shadows
shadow = true;
shadow-radius = 14;
shadow-opacity = 0.45;
shadow-offset-x = -12;
shadow-offset-y = -12;
shadow-exclude = [
  "window_type = 'desktop'"
];

inactive-opacity = 0.92;
active-opacity = 1.0;

