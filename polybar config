[colors]
background = #CC14141E
background-alt = #33FFFFFF
foreground = #E6E9EF
primary = #C678DD
secondary = #61AFEF
alert = #E06C75
disabled = #6C7086

[bar/example]
width = 98.5%
height = 30px
offset-x = 0.75%
offset-y = 8px
radius = 12
fixed-center = true

background = ${colors.background}
foreground = ${colors.foreground}

line-size = 2pt
border-size = 1pt
border-color = #26FFFFFF

padding-left = 2
padding-right = 2
module-margin = 1

font-0 = "JetBrainsMono Nerd Font:size=9;2"
font-1 = "JetBrainsMono Nerd Font:size=8;2"

modules-left = bspwm
modules-center = date
modules-right = backlight pulseaudio bluetooth wlan battery

cursor-click = pointer
cursor-scroll = ns-resize
enable-ipc = true
wm-restack = bspwm

[module/bspwm]
type = internal/bspwm
pin-workspaces = true
enable-click = true
enable-scroll = true

label-focused = 󰮯
label-focused-foreground = ${colors.primary}
label-focused-padding = 1

label-occupied = 󰊠
label-occupied-foreground = ${colors.secondary}
label-occupied-padding = 1

label-urgent = 
label-urgent-foreground = ${colors.alert}
label-urgent-padding = 1

label-empty = 
label-empty-foreground = ${colors.disabled}
label-empty-padding = 1

[module/date]
type = internal/date
interval = 1
date = %H:%M  %a, %d %b
label =  %date%
label-foreground = ${colors.foreground}

[module/backlight]
type = internal/backlight
use-actual-brightness = true
enable-scroll = true
scroll-interval = 5
format = <ramp> <label>
label = %percentage%%
ramp-0 = 󰃞
ramp-1 = 󰃟
ramp-2 = 󰃠
ramp-foreground = #E5C07B

[module/pulseaudio]
type = internal/pulseaudio
use-ui-max = false
interval = 5
format-volume = <ramp-volume> <label-volume>
label-volume = %percentage%%
label-muted = 󰖁 Muted
label-muted-foreground = ${colors.disabled}
ramp-volume-0 = 󰕿
ramp-volume-1 = 󰖀
ramp-volume-2 = 󰕾
ramp-volume-foreground = #98C379
click-right = pavucontrol &

[module/bluetooth]
type = custom/script
exec = bluetoothctl show | grep -q "Powered: yes" && echo "󰂯 On" || echo "󰂲 Off"
interval = 3
click-left = blueman-manager &
click-right = bluetoothctl power toggle
format-foreground = #61AFEF

[module/wlan]
type = internal/network
interface-type = wireless
interval = 3
format-connected = %{A1:nm-connection-editor &:}󰤨%{A}
format-connected-foreground = #56B6C2
format-disconnected = %{A1:nm-connection-editor &:}󰤭%{A}
format-disconnected-foreground = ${colors.disabled}

[module/battery]
type = internal/battery
full-at = 99
low-at = 15
battery = BAT0
adapter = ADP1
poll-interval = 5
format-charging = <animation-charging> <label-charging>
format-discharging = <ramp-capacity> <label-discharging>
format-full = 󰁹 <label-full>
label-charging = %percentage%%
label-discharging = %percentage%%
label-full = %percentage%%
ramp-capacity-0 = 󰂎
ramp-capacity-1 = 󰁺
ramp-capacity-2 = 󰁼
ramp-capacity-3 = 󰁾
ramp-capacity-4 = 󰂀
ramp-capacity-5 = 󰁹
ramp-capacity-foreground = #E06C75
animation-charging-0 = 󰂆
animation-charging-1 = 󰂈
animation-charging-2 = 󰂊
animation-charging-3 = 󰂅
animation-charging-foreground = #98C379
animation-charging-framerate = 750
